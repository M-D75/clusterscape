{
  "name": "clusterscape",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:simulator\" \"npm:web\"",
    "web": "vite --host 127.0.0.1 apps/web",
    "simulator": "node --import tsx apps/simulator/index.ts",
    "build": "vite build apps/web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test packages/cluster-model/model.test.ts",
    "test:stream": "node --import tsx scripts/verify-stream.ts",
    "examples": "node --import tsx scripts/export-examples.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^8.17.10",
    "@react-three/drei": "^9.120.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "@types/node": "^22.9.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
